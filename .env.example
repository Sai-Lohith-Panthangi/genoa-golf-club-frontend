# Copy to .env.local to run against the Spring Boot backend
# (github.com/<you>/genoa-golf-club-backend). Leave unset to run in demo mode
# with built-in sample data and simulated form submissions.
VITE_API_BASE_URL=http://localhost:8080

# Dev-profile backend skips reCAPTCHA; any non-empty token is accepted.
VITE_RECAPTCHA_TOKEN=dev-token
